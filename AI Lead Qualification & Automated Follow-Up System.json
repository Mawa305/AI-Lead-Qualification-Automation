      "parameters": {
        "promptType": "define",
        "text": "=Name: {{$json.Name}}\nEmail: {{$json.Email}}\nBusiness: {{$json[\"Business/Company\"]}}\nHelp Needed: {{$json[\"What do you need help with?\"]}}\nBudget: {{$json.Budget}}\nAdditional Details: {{$json[\"Additional Details\"]}}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an AI Lead Qualification Agent for a business.\n\nAnalyze the lead information provided by the user and return a structured qualification.\n\nYour responsibilities:\n1. Identify the lead's business and requirements.\n2. Understand their main problem or requested service.\n3. Consider their stated budget, urgency, and level of intent.\n4. Classify the lead as Hot, Warm, or Cold based only on the information provided.\n5. Give a concise reason for the classification.\n6. Create a short, factual lead summary.\n7. Write a professional and friendly follow-up message.\n8. Do not invent missing information or make assumptions about the lead.\n9. If important information is missing, mention it briefly in the summary.\n\nKeep the output concise and professional.\n\nThe output must follow the required structured format exactly.\nDo not include the lead's email address in the lead summary.\n\nKeep the suggested follow-up under 120 words and ask only the 3 most important missing questions."
        }
      },
